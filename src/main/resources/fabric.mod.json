{
  "schemaVersion": 1,
  "id": "chatbridge",
  "version": "${version}",
  "name": "ChatBridge",
  "description": "Provides customizable formatting for bridge bot messages.",
  "authors": [
    "FanerXp"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/chatbridge",
    "sources": "https://github.com/unknown-salt/chatbridge",
    "issues": "https://github.com/unknown-salt/chatbridge/issues"
  },
  "license": "MIT",
  "icon": "assets/chatbridge/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "com.chatbridge.ChatBridge",
        "adapter": "kotlin"
      }
    ],
    "modmenu": [
      "com.chatbridge.config.ChatBridgeModMenu"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/chatbridge"
      }
    }
  }
}
